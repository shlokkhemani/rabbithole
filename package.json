{
  "name": "nora",
  "version": "0.1.0",
  "type": "module",
  "description": "A VS Code research canvas for .nora documents.",
  "license": "MIT",
  "author": "Shlok Khemani",
  "homepage": "https://github.com/r13v/Nora#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/r13v/Nora"
  },
  "displayName": "Nora",
  "publisher": "r13v",
  "main": "./out/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCustomEditor:nora.research",
    "onCommand:nora.newResearch",
    "onCommand:nora.undo",
    "onCommand:nora.redo",
    "onCommand:nora.ask",
    "onCommand:nora.selectProfile",
    "onCommand:nora.setCredential",
    "onCommand:nora.signIn",
    "onCommand:nora.signOut",
    "onCommand:nora.addRepository",
    "onCommand:nora.addAttachment",
    "onCommand:nora.exportMarkdown",
    "onCommand:nora.exportSnapshot"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false
    },
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "nora.research",
        "displayName": "Nora Research Canvas",
        "selector": [
          {
            "filenamePattern": "*.nora"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nora.newResearch",
        "title": "New Research",
        "category": "Nora"
      },
      {
        "command": "nora.undo",
        "title": "Undo",
        "category": "Nora"
      },
      {
        "command": "nora.redo",
        "title": "Redo",
        "category": "Nora"
      },
      {
        "command": "nora.ask",
        "title": "Ask Nora",
        "category": "Nora"
      },
      {
        "command": "nora.selectProfile",
        "title": "Select Profile",
        "category": "Nora"
      },
      {
        "command": "nora.setCredential",
        "title": "Set Credential",
        "category": "Nora"
      },
      {
        "command": "nora.signIn",
        "title": "Sign In",
        "category": "Nora"
      },
      {
        "command": "nora.signOut",
        "title": "Sign Out",
        "category": "Nora"
      },
      {
        "command": "nora.addRepository",
        "title": "Add Repository",
        "category": "Nora"
      },
      {
        "command": "nora.addAttachment",
        "title": "Add Attachment",
        "category": "Nora"
      },
      {
        "command": "nora.exportMarkdown",
        "title": "Export Markdown",
        "category": "Nora"
      },
      {
        "command": "nora.exportSnapshot",
        "title": "Export Snapshot",
        "category": "Nora"
      }
    ],
    "keybindings": [
      {
        "command": "nora.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == nora.research"
      },
      {
        "command": "nora.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == nora.research"
      }
    ],
    "configuration": {
      "title": "Nora",
      "properties": {
        "nora.llm.profiles": {
          "type": "array",
          "default": [],
          "description": "Named Nora LLM profiles. Credentials are stored separately in VS Code SecretStorage.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "api": {
                "type": "string",
                "enum": [
                  "openai-completions",
                  "openai-responses"
                ]
              },
              "customModel": {
                "type": "object"
              }
            }
          }
        },
        "nora.mcp.directTools": {
          "type": "array",
          "default": [],
          "description": "Nora MCP tool names that may be called directly.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:nora",
    "build:nora": "node scripts/build-nora.mjs --outdir out",
    "check": "npm run check:types && npm run check:purity && npm run check:build && npm run check:native && npm run check:pi-runtime && npm run check:legacy && npm run check:workflows",
    "check:build": "node scripts/check-build.mjs",
    "check:legacy": "node scripts/check-legacy-surfaces.mjs",
    "check:native": "node scripts/check-native-artifacts.mjs",
    "check:pi-runtime": "node scripts/check-pi-runtime-assets.mjs",
    "check:purity": "node scripts/check-ui-purity.mjs",
    "check:types": "tsc --noEmit",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test": "npm run build && npm run check && npm run test:unit && npm run test:contracts && npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:packaging",
    "test:unit": "node test/unit/markdown-renderer.test.mjs && node test/unit/content-blocks.test.mjs && node test/unit/base-url.test.mjs && node test/unit/icons.test.mjs && node test/unit/document-state.test.mjs && node --test test/unit/agent-context.test.mjs && node test/unit/llm-profiles.test.mjs && node --test test/unit/git-remote.test.mjs test/unit/git-permalink.test.mjs test/unit/code-tools.test.mjs test/unit/skills-loader.test.mjs test/unit/mcp-config.test.mjs test/unit/mcp-output.test.mjs && node test/unit/pdf-provenance.test.mjs && node test/unit/pdf-selection.test.mjs && node test/unit/lifecycle.test.mjs",
    "test:contracts": "node test/contracts/prompts.test.mjs && node test/contracts/ui-bundle-boundaries.test.mjs && node test/contracts/webview-protocol.test.mjs && node --test test/contracts/nora-archive.test.mjs test/contracts/nora-archive-security.test.mjs test/contracts/attachment-boundaries.test.mjs test/contracts/llm-secret-boundary.test.mjs test/contracts/agent-transcript.test.mjs test/contracts/export-security.test.mjs",
    "test:integration": "node test/integration/pdf-webview.test.mjs && node test/integration/pdf-snapshot.test.mjs && node test/integration/image-experience.test.mjs && node test/integration/llm-auth.test.mjs && node test/integration/mermaid-rendering.test.mjs && node --test test/integration/nora-document-lifecycle.test.mjs test/integration/repository-cache.test.mjs test/integration/skills-resource-loader.test.mjs test/integration/pi-run.test.mjs test/integration/mcp-bridge.test.mjs test/integration/nora-export.test.mjs",
    "test:e2e": "node test/e2e/webview-research.test.mjs && node test/e2e/ui-primitives-browsers.test.mjs",
    "test:vscode": "npm run build:nora && node test/vscode/run.mjs",
    "package:vsix": "npm run build:nora && node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vsce package --no-dependencies --out artifacts/nora.vsix && npm run check:native",
    "test:vsix": "node test/packaging/vsix-install-smoke.test.mjs",
    "test:performance": "node test/performance/budgets.test.mjs",
    "test:packaging": "node test/packaging/vsix-contents.test.mjs && node test/packaging/package-boundaries.test.mjs",
    "calibrate:budgets": "node test/support/calibrate-budgets.mjs"
  },
  "keywords": [
    "vscode",
    "research",
    "canvas",
    "mcp",
    "agent"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@mermaid-js/tiny": "11.16.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "^3.4.11",
    "dotenv": "17.4.2",
    "highlight.js": "^11.11.1",
    "jsonc-parser": "3.3.1",
    "katex": "^0.17.0",
    "marked": "^15.0.7",
    "pdfjs-dist": "^4.0.379",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=24",
    "vscode": "^1.130.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "actionlint": "2.0.6",
    "esbuild": "0.28.1",
    "mocha": "11.7.6",
    "ovsx": "1.0.2",
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  }
}
