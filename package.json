{
  "name": "@shlokkhemani/rabbithole",
  "version": "0.1.0",
  "type": "module",
  "description": "An infinite canvas for learning. Start from a document, select text, ask, and the answer branches out as a child document. Recurse forever.",
  "license": "MIT",
  "author": "Shlok Khemani",
  "homepage": "https://rabbithole.ing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlokkhemani/rabbithole.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:publish": "node scripts/build-publish.mjs",
    "generate:icons": "node scripts/generate-ionicons.mjs",
    "generate:design-doc": "node scripts/generate-design-doc.mjs",
    "icons:studio": "node tools/icon-studio/server.mjs",
    "check:icons": "node scripts/generate-ionicons.mjs --check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:css": "node scripts/check-css-integrity.mjs",
    "check:docs": "node scripts/build-docs.mjs --check",
    "check:design": "node scripts/check-design.mjs",
    "check:design-doc": "node scripts/generate-design-doc.mjs --check",
    "check:bridge-live": "node scripts/bridge-live-check.mjs",
    "check:install-live": "node scripts/install-journey-check.mjs",
    "check:vision-live": "node scripts/vision-live-check.mjs",
    "check:isolation-live": "node test/run.mjs isolation-live",
    "check:purity": "node scripts/check-ui-purity.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:ui": "biome check src/ui",
    "check:ui-architecture": "node scripts/check-ui-architecture.mjs",
    "format:ui": "biome check --write --unsafe src/ui",
    "test": "node test/run.mjs all",
    "test:unit": "node test/run.mjs unit",
    "test:contracts": "node test/run.mjs contracts",
    "test:integration": "node test/support/local-tier.mjs integration",
    "test:e2e": "node test/support/local-tier.mjs e2e",
    "test:quick": "node test/support/quick-test.mjs",
    "test:performance": "node test/run.mjs performance",
    "test:packaging": "node test/run.mjs packaging",
    "calibrate:budgets": "node test/support/calibrate-budgets.mjs",
    "eval": "node test/evals/run-eval.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "learning",
    "canvas",
    "claude-code",
    "codex",
    "agent"
  ],
  "bin": {
    "rabbithole": "bin/rabbithole.js",
    "rabbithole-mcp": "bin/mcp-server.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@mermaid-js/tiny": "11.16.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^15.0.7",
    "pdfjs-dist": "^4.0.379",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@iconify-json/ion": "1.0.2",
    "@types/node": "^26.4.0",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "lightningcss": "^1.33.0",
    "playwright": "^1.61.1",
    "terser": "^5.51.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "canvas": "-",
    "fast-uri": "3.1.3"
  }
}
